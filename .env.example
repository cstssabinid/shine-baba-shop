# Runtime Neon/PostgreSQL connection. Use the pooled URL for Vercel Functions.
# For local development, put the Neon development/preview branch URLs in ignored .env.local.
# This localhost value is only an example for a local PostgreSQL server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shine_baba_shop?schema=public"

# Use the direct, unpooled URL for Prisma migrations. Do not use a production URL with migrate dev.
# Neon provides DATABASE_URL_UNPOOLED; DIRECT_URL is also supported by prisma.config.ts.
# DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/shine_baba_shop?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shine_baba_shop?schema=public"

# Manager dashboard password must be unique and at least 16 characters; its session signing key needs 32+ characters.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Set these in ignored .env.local and in the Vercel project's Production and Preview environments.
# ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-16-characters"
# ADMIN_SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Customer phone/password accounts. Generate the Better Auth secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use http://localhost:3000 locally and https://shinebabashop.com in Vercel Production.
# BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# BETTER_AUTH_URL="http://localhost:3000"

# Connect a public Vercel Blob store to enable product photo uploads.
# Pull the Development environment value locally with `vercel env pull .env.local`.
# BLOB_READ_WRITE_TOKEN=""

# Add provider secrets only after an approved payment integration is selected.
# PAYMENT_API_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

